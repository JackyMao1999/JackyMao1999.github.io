<audio id="music-audio" preload="none"></audio>

<div id="floating-music">
  <button id="music-toggle" title="音乐播放器">
    <i class="fa-solid fa-play"></i>
  </button>
  <div id="music-panel">
    <button class="music-ctrl" id="music-prev" title="上一首"><i class="fa-solid fa-backward-step"></i></button>
    <button class="music-ctrl" id="music-pp" title="播放/暂停"><i class="fa-solid fa-play"></i></button>
    <button class="music-ctrl" id="music-next" title="下一首"><i class="fa-solid fa-forward-step"></i></button>
    <div id="music-meta">
      <span id="music-title"></span>
      <span id="music-artist"></span>
    </div>
    <span id="music-time">00:00</span>
  </div>
</div>

<script>
(function() {
  var header = document.getElementById('l_header');
  if (header && document.getElementById('cover')) {
    header.style.display = 'none';
  }

  var PLAYLIST = [
    { id: '1836021414', title: '黄金时代', artist: '声音碎片乐队' }
  ];

  var audio = document.getElementById('music-audio');
  var toggleBtn = document.getElementById('music-toggle');
  var ppBtn = document.getElementById('music-pp');
  var prevBtn = document.getElementById('music-prev');
  var nextBtn = document.getElementById('music-next');
  var titleEl = document.getElementById('music-title');
  var artistEl = document.getElementById('music-artist');
  var timeEl = document.getElementById('music-time');

  var currentTrack = 0;
  var playing = false;

  function formatTime(s) {
    if (isNaN(s) || s === Infinity) return '00:00';
    var m = Math.floor(s / 60);
    var sec = Math.floor(s % 60);
    return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
  }

  function loadTrack() {
    var track = PLAYLIST[currentTrack];
    titleEl.textContent = track.title;
    artistEl.textContent = track.artist;
    timeEl.textContent = '00:00';
    audio.src = '/music/' + track.id + '.mp3';
    audio.load();
  }

  function setPlaying(state) {
    playing = state;
    var icon = state ? 'fa-pause' : 'fa-play';
    toggleBtn.innerHTML = '<i class="fa-solid ' + icon + '"></i>';
    ppBtn.innerHTML = '<i class="fa-solid ' + icon + '"></i>';

    if (state) {
      toggleBtn.classList.add('playing');
      var promise = audio.play();
      if (promise && promise.catch) {
        promise.catch(function() {
          setPlaying(false);
        });
      }
    } else {
      toggleBtn.classList.remove('playing');
      audio.pause();
    }
  }

  toggleBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (playing) setPlaying(false);
    else setPlaying(true);
  });

  ppBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (playing) setPlaying(false);
    else setPlaying(true);
  });

  prevBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (PLAYLIST.length <= 1) return;
    currentTrack = (currentTrack - 1 + PLAYLIST.length) % PLAYLIST.length;
    var wasPlaying = playing;
    setPlaying(false);
    loadTrack();
    if (wasPlaying) {
      audio.addEventListener('canplay', function onReady() {
        audio.removeEventListener('canplay', onReady);
        setPlaying(true);
      }, { once: true });
    }
  });

  nextBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (PLAYLIST.length <= 1) return;
    currentTrack = (currentTrack + 1) % PLAYLIST.length;
    var wasPlaying = playing;
    setPlaying(false);
    loadTrack();
    if (wasPlaying) {
      audio.addEventListener('canplay', function onReady() {
        audio.removeEventListener('canplay', onReady);
        setPlaying(true);
      }, { once: true });
    }
  });

  audio.addEventListener('timeupdate', function() {
    timeEl.textContent = formatTime(audio.currentTime) + ' / ' + formatTime(audio.duration);
  });

  audio.addEventListener('loadedmetadata', function() {
    timeEl.textContent = '00:00 / ' + formatTime(audio.duration);
  });

  audio.addEventListener('ended', function() {
    if (PLAYLIST.length <= 1) {
      setPlaying(false);
      audio.currentTime = 0;
      timeEl.textContent = '00:00 / ' + formatTime(audio.duration);
      return;
    }
    currentTrack = (currentTrack + 1) % PLAYLIST.length;
    loadTrack();
    setPlaying(true);
  });

  audio.addEventListener('error', function() {
    setPlaying(false);
    timeEl.textContent = '加载失败';
  });

  if (PLAYLIST.length <= 1) {
    prevBtn.style.display = 'none';
    nextBtn.style.display = 'none';
  }

  loadTrack();
})();
</script>
